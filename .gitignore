# =====================================================
# .gitignore  ——  Git 黑名单备忘录
# 作用：告诉 Git 哪些文件 / 文件夹"不要跟踪、不要上传"
# 大白话：相当于搬家公司只搬"有用的家具"，这些是"废品清单"
# =====================================================

# ---------- 1. 操作系统垃圾 ----------
# Windows 系统生成的隐藏垃圾
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS 系统生成的隐藏垃圾
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
Icon?
.DocumentRevisions-V100*
.fseventsd*
.Spotlight-V100*
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Linux 系统垃圾
*~
.fuse_hidden*
.Trash-*
.nfs*

# ---------- 2. IDE / 编辑器 ----------
# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
!.vscode/launch.json.example
!.vscode/tasks.json.example

# IntelliJ / PyCharm / WebStorm / IDEA
.idea/
*.iml
*.iws
*.ipr
*.swp

# Eclipse / NetBeans
*.project
*.classpath
.settings/
nbproject/
nbbuild/
nbdist/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
.history
/[Ss]hare/[Rr]e[Ss]ources/[Ss]ession.lock

# ---------- 3. Python 生态 ----------
# 字节码 / 缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境
venv/
env/
ENV/
.venv/
.env/
.python-version

# 打包 / 分发
*.egg-info/
*.egg
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.whl
*.tar.gz

# 测试 / 覆盖率
.pytest_cache/
.coverage
.coverage.*
.cache
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# Django / Flask / FastAPI
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
instance/
.webassets-cache

# Jupyter Notebook
.ipynb_checkpoints
profile_default/
ipython_config.py
*.ipynb_checkpoints

# mypy / bandit
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
cython_debug/

# poetry / pipenv
Pipfile.lock

# ---------- 4. Node / JavaScript 生态 ----------
# 依赖
node_modules/
jspm_packages/

# 构建产物
/build
/dist
/out
/.next
/.nuxt
/.cache

# 日志 / 运行时
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# 覆盖率 / 缓存
.nyc_output
coverage/
*.lcov

# 配置 / 环境变量（千万不要上传密码）
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# TypeScript
*.tsbuildinfo

# 各种框架
.grunt/
.lock-wscript
.bower-cache/
.bower-registry/
.bower-tmp/
.node-cache/
.yarn-integrity
.yarn/build-state.yml
.yarn/unplugged
.pnp.*

# 工具链
.eslintcache
.stylelintcache
.parcel-cache/
.cache-loader/

# ---------- 5. Java / JVM ----------
*.class
*.log
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*
target/

# ---------- 6. C / C++ ----------
# 依赖
*.deps
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll

# 构建
[Bb]uild/
[Ll]og/
[Oo]bj/
[Oo]ut/
[Dd]ist/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
CMakeUserPresets.json
*.cmake

# Make / Ninja
*.makefile
*.mk
*.make

# Valgrind / 覆盖率
*.gcda
*.gcno
*.gcov
valgrind/

# ---------- 7. Go / Rust ----------
# Go
/vendor/
/vendor.bak
*.exe
*.test
*.prof

# Rust
/target/
**/*.rs.bk
Cargo.lock

# ---------- 8. 数据库 / 数据文件 ----------
*.db
*.sqlite
*.sqlite3
*.mdb

# ---------- 9. 文档 / Office 临时 ----------
~$*.doc*
~$*.xls*
~$*.ppt*
*.tmp
*.temp
*.swp

# ---------- 10. 媒体 / 大型二进制 ----------
*.mp4
*.mov
*.avi
*.mkv
*.flv
*.wmv
*.webm
*.mp3
*.wav
*.flac
*.psd
*.ai
*.sketch
*.fig

# ---------- 11. 密钥 / 凭证（再保险） ----------
*.pem
*.key
*.crt
*.pfx
*.p12
secrets.*
credentials.*
*.token
*.secret

# ---------- 12. 日志 ----------
*.log
logs/
log/

# ---------- 13. 杂项 ----------
.bundle/
vendor/bundle
.byebug_history

# 不要忽略这些"看似隐藏但很有用"的文件
!.gitkeep
!.gitattributes
!.editorconfig
!.gitignore
!.dockerignore
!README.md
